HTTP_ADDR=:8080
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgres://ota:ota@localhost:5432/ota?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=10
# OAuth/OIDC authentication. When configured, all non-health API routes require
# a signed ID token from the discovered issuer with the configured audience.
# Set OIDC_REQUIRED=true to fail configuration startup when these are absent.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_REQUIRED=false
# Explicit production provider: aws-kms, apple-app-attest, google-play-integrity,
# android-play-integrity, or cloudhsm-pkcs11. Staging and production require it.
ATTESTATION_PROVIDER=aws-kms
AWS_REGION=eu-north-1
# Google Play Integrity legacy/decode adapter configuration.
GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME=
GOOGLE_PLAY_INTEGRITY_CREDENTIALS_FILE=
GOOGLE_PLAY_INTEGRITY_CREDENTIALS_JSON=
GOOGLE_PLAY_INTEGRITY_REQUIRE_LICENSED=true
# When set, enables the fail-closed AWS KMS asymmetric SIGN_VERIFY adapter.
AWS_KMS_KEY_ID=
AWS_KMS_SIGNING_ALGORITHM=RSASSA_PKCS1_V1_5_SHA_256
# Apple App Attest is enabled only when APPLE_APP_ID and exactly one root source are set.
APPLE_APP_ID=
APPLE_APP_ATTEST_ENVIRONMENT=production
APPLE_APP_ATTEST_ROOT_CERT_FILE=
# For ECS/Secrets Manager, inject the PEM through this variable instead of a file.
APPLE_APP_ATTEST_ROOT_CERT_PEM=
# Android Play Integrity is enabled only when all three core values are set.
ANDROID_PACKAGE_NAME=
ANDROID_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
ANDROID_PLAY_INTEGRITY_MODE=standard
ANDROID_PLAY_INTEGRITY_MAX_TOKEN_AGE_SECONDS=120
ANDROID_PLAY_INTEGRITY_ALLOWED_DEVICE_VERDICTS=MEETS_DEVICE_INTEGRITY
ANDROID_PLAY_INTEGRITY_REQUIRE_LICENSED=true
# Store service-account JSON in a secret manager; never commit it.
ANDROID_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# ECS deployments should use the secret ARN instead of passing JSON locally.
ANDROID_PLAY_INTEGRITY_SERVICE_ACCOUNT_SECRET_ARN=
