HTTP_ADDR=:8080
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgres://ota:ota@localhost:5432/ota?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=10
AWS_REGION=eu-north-1
# When set, enables the fail-closed AWS KMS asymmetric SIGN_VERIFY adapter.
AWS_KMS_KEY_ID=
AWS_KMS_SIGNING_ALGORITHM=RSASSA_PKCS1_V1_5_SHA_256
# Apple App Attest is enabled only when APPLE_APP_ID and exactly one root source are set.
APPLE_APP_ID=
APPLE_APP_ATTEST_ENVIRONMENT=production
APPLE_APP_ATTEST_ROOT_CERT_FILE=
# For ECS/Secrets Manager, inject the PEM through this variable instead of a file.
APPLE_APP_ATTEST_ROOT_CERT_PEM=
