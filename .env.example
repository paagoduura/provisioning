HTTP_ADDR=:8080
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgres://ota:ota@localhost:5432/ota?sslmode=disable
SUPABASE_AUTH_ISSUER=https://haytetewtgbfxnolrhjz.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
# Optional inputs for scripts/auth-email-otp-e2e.ps1; never use a service-role key here.
SUPABASE_URL=https://haytetewtgbfxnolrhjz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379/0
# Interswitch sandbox/product contract. Use the exact URLs supplied for the enabled API product.
INTERSWITCH_TOKEN_URL=
INTERSWITCH_REQUEST_URL=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_WEBHOOK_SECRET=
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=10
# Observability. Leave the OTLP endpoint empty to disable trace export.
OTEL_SERVICE_NAME=provisioning-api
OTEL_RESOURCE_ATTRIBUTES_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional HTTPS endpoint for signed security-failure notifications.
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_SECRET=
# Explicit production provider: aws-kms, apple-app-attest, google-play-integrity, or cloudhsm-pkcs11.
# Staging and production refuse to start without this value.
ATTESTATION_PROVIDER=aws-kms
# Google Play Integrity configuration when ATTESTATION_PROVIDER=google-play-integrity.
# Prefer a secret-mounted file over putting credential JSON in the environment.
GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME=
GOOGLE_PLAY_INTEGRITY_CREDENTIALS_FILE=
GOOGLE_PLAY_INTEGRITY_CREDENTIALS_JSON=
GOOGLE_PLAY_INTEGRITY_REQUIRE_LICENSED=true
AWS_REGION=eu-north-1
# When set, enables the fail-closed AWS KMS asymmetric SIGN_VERIFY adapter.
AWS_KMS_KEY_ID=
AWS_KMS_SIGNING_ALGORITHM=RSASSA_PKCS1_V1_5_SHA_256
# Apple App Attest configuration when ATTESTATION_PROVIDER=apple-app-attest.
# APPLE_APP_ATTEST_ROOT_CERT_FILE must point to Apple's official App Attest root certificate.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_APP_ATTEST_ENVIRONMENT=production
APPLE_APP_ATTEST_ROOT_CERT_FILE=

# staging and production fail closed unless DATABASE_URL points to durable PostgreSQL.
# For Supabase, use the pooler connection string and keep it in the deployment secret store.
