HTTP_ADDR=:8080
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgres://ota:ota@localhost:5432/ota?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=10
# Explicit production provider: aws-kms, apple-app-attest, google-play-integrity, or cloudhsm-pkcs11.
# Staging and production refuse to start without this value.
ATTESTATION_PROVIDER=aws-kms
AWS_REGION=eu-north-1
# When set, enables the fail-closed AWS KMS asymmetric SIGN_VERIFY adapter.
AWS_KMS_KEY_ID=
AWS_KMS_SIGNING_ALGORITHM=RSASSA_PKCS1_V1_5_SHA_256

# staging and production fail closed unless DATABASE_URL points to durable PostgreSQL.
# For Supabase, use the pooler connection string and keep it in the deployment secret store.
